# Copy this file to .env and fill in your keys. Never commit .env.

# Required: Claude (Budu's brain) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5

# Optional: pictures + safety moderation — https://platform.openai.com
# Without it, Budu can still talk, but can't draw pictures.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=low

# A shared secret the app must send (set the same value in the app's parent settings).
APP_TOKEN=change-me-to-something-long-and-random

# Cost / abuse limits per device
MAX_CHATS_PER_MINUTE=20
MAX_IMAGES_PER_HOUR=15
