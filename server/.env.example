# Copy this file to .env and fill in your keys. Never commit .env.

# Required: Claude (Budu's brain) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5

# Optional: pictures + safety moderation — https://platform.openai.com
# Without it, Budu can still talk, but can't draw pictures.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low

# A shared secret the app must send (set the same value in the app's parent settings).
APP_TOKEN=change-me-to-something-long-and-random

# Cost / abuse limits per device
MAX_CHATS_PER_MINUTE=20
MAX_IMAGES_PER_HOUR=15

# Optional: Budu's natural voice (Google Cloud Text-to-Speech, Chirp 3 HD voices).
# Without it, the tablet's own voice is used.
GOOGLE_TTS_API_KEY=
# Voice name, e.g. Leda, Aoede, Kore, Zephyr (female) or Puck, Charon, Fenrir (male).
GOOGLE_TTS_VOICE=Leda
# Speaking speed: empty = normal, 0.9 = a bit slower for little ears.
GOOGLE_TTS_SPEAKING_RATE=
MAX_SPEAK_PER_MINUTE=40
# Stop using the Google voice after this many characters per month (free tier is 1,000,000).
# After that, Budu uses the tablet voice until the 1st. 0 = no limit.
GOOGLE_TTS_MONTHLY_CHAR_LIMIT=950000
